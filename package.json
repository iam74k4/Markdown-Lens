{
  "name": "markdown-review",
  "displayName": "Markdown Review",
  "description": "差分が見えるMarkdownをそのまま編集。WYSIWYG・ソース・図・表を1画面で確認。",
  "version": "0.9.0",
  "publisher": "local-markdown-review",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "diff",
    "review",
    "cursor",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:markdownReview.preview",
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownReview.open",
        "title": "変更プレビューを開く",
        "category": "Markdown Review",
        "icon": "$(diff)"
      },
      {
        "command": "markdownReview.refresh",
        "title": "未確認ファイルを更新",
        "category": "Markdown Review",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownReview.open",
          "when": "editorLangId == markdown && resourceScheme != untitled",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownReview.open",
          "when": "resourceExtname =~ /\\.(md|markdown|mdown)$/i",
          "group": "navigation@20"
        }
      ],
      "view/title": [
        {
          "command": "markdownReview.refresh",
          "when": "view == markdownReview.pending",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "markdownReview.pending",
          "name": "Markdown Lens · 未確認"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "markdownReview.pending",
        "contents": "未確認の変更はありません。\n初回読み込みで比較元を保存し、以降の変更を表示します。"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/core.test.ts test/store.test.ts test/rich.test.ts test/features.test.ts test/inline-review.test.ts test/quick-table.test.ts test/section-folding.test.ts test/colors.test.ts",
    "test:host": "node scripts/run-host-tests.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "vscode:prepublish": "npm run check && npm run build && node scripts/notices.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "test:diagrams": "node scripts/test-diagrams.mjs",
    "test:tables": "node scripts/test-tables.mjs",
    "test:rich": "node scripts/test-rich-editor.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "markdown-it": "14.3.3",
    "mermaid": "11.17.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iam74k4/Markdown-Lens.git"
  },
  "bugs": {
    "url": "https://github.com/iam74k4/Markdown-Lens/issues"
  },
  "homepage": "https://github.com/iam74k4/Markdown-Lens#readme",
  "overrides": {
    "katex": "0.18.2"
  }
}
